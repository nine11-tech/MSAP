# MSAP dynamic Android lab local configuration.
# Copy to .msap-dynamic-lab.local.env in the repository root if overrides are
# needed. Do not commit the local file.

MSAP_ANDROID_SERIAL=emulator-5554
MSAP_AVD_NAME=Lab-Root
MSAP_CLEAN_SNAPSHOT=msap-clean-base
MSAP_INSTRUMENTED_SNAPSHOT=msap-instrumented-base
MSAP_ANDROID_API_LEVEL=35
MSAP_ANDROID_ABI=x86_64
MSAP_EXPECTED_BUILD_TYPE=userdebug
MSAP_EXPECTED_FRIDA_VERSION=17.16.4
MSAP_EXPECTED_MITMPROXY_VERSION=12.2.3
MSAP_EXPECTED_CA_SHA256=dec0e1d91937af25da3b84e6350cb12dc0382f1371960351baffcfa91736dc05
MSAP_EXPECTED_APEX_CA_COUNT=145
MSAP_PROXY_PORT=18080
MSAP_FRIDA_ADB_PORT=27042
MSAP_FRIDA_BRIDGE_PORT=27043

# Optional comma-separated package allowlist for health/preflight after an
# auditor-authorized target is intentionally installed. Empty remains the
# strict clean-baseline default. Snapshot restoration still requires zero.
MSAP_PREFLIGHT_ALLOWED_THIRD_PARTY_PACKAGES=

# Windows-native SDK path used by PowerShell scripts.
ANDROID_SDK_WIN='C:\Users\lenovo\AppData\Local\Android\Sdk'

# WSL paths used by Bash scripts. The defaults match the validated workstation.
ANDROID_SDK_WSL=/mnt/c/Users/lenovo/AppData/Local/Android/Sdk
ADB_WIN=/mnt/c/Users/lenovo/AppData/Local/Android/Sdk/platform-tools/adb.exe
EMULATOR_WIN=/mnt/c/Users/lenovo/AppData/Local/Android/Sdk/emulator/emulator.exe
MSAP_ANDROID_PLATFORM_JAR=/mnt/c/Users/lenovo/AppData/Local/Android/Sdk/platforms/android-35/android.jar
MSAP_BUILD_TOOLS_DIR=/mnt/c/Users/lenovo/AppData/Local/Android/Sdk/build-tools/36.0.0

# Local-only dynamic tooling and evidence directories. These must stay outside
# the repository because they may contain generated CA material, APKs, logs, and
# emulator-derived evidence.
MSAP_DYNAMIC_HOME="$HOME/.local/share/msap-dynamic"
MSAP_MITMPROXY_VENV="$HOME/.local/share/msap-dynamic/venvs/mitmproxy"
MSAP_MITMPROXY_CONF="$HOME/.local/share/msap-dynamic/tools/mitmproxy/conf"
MSAP_EVIDENCE_ROOT="$HOME/.local/share/msap-dynamic/evidence/reproducibility"
