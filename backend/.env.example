DJANGO_SETTINGS_MODULE=msap.settings.development
SECRET_KEY=change-me
DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
MSAP_ENVIRONMENT=development

# Use DATABASE_URL or the POSTGRES_* variables below.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=msap
POSTGRES_USER=msap_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=msap-access
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_APK_UPLOADS=msap-apk-uploads
MINIO_BUCKET_ARTIFACTS=msap-artifacts
MINIO_BUCKET_EVIDENCE=msap-evidence
MINIO_BUCKET_REPORTS=msap-reports
MINIO_BUCKET_EXPORTS=msap-exports

MSAP_MAX_APK_SIZE_BYTES=524288000
MSAP_MAX_MANIFEST_SIZE_BYTES=4194304
MSAP_MAX_APK_ZIP_ENTRIES=10000
# Optional development/test mirror root: <root>/<bucket>/<object_key>.
MSAP_LOCAL_APK_ROOT=
MSAP_UPLOAD_REQUIRE_SHA256=true
MSAP_PRESIGNED_URL_EXPIRES_SECONDS=900
MSAP_VERIFY_UPLOAD_WITH_HEAD=false
MSAP_DEFAULT_RETENTION_POLICY=active_audit
MSAP_LOG_LEVEL=INFO
MSAP_REDACTION_ENABLED=true

ANALYZER_RULES_PATH=../rules
ANALYZER_WORKDIR=/tmp/msap-analysis
ANALYZER_TIMEOUT_SECONDS=600

REPORT_DEFAULT_FORMAT=json
REPORT_BUCKET=msap-reports
EXPORT_BUCKET=msap-exports
REPORT_INCLUDE_EVIDENCE=true
REPORT_REDACTION_REQUIRED=true

AI_ASSISTANT_ENABLED=false
