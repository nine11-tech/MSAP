DJANGO_SETTINGS_MODULE=msap.settings.development
SECRET_KEY=change-me
DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MSAP_ENVIRONMENT=development
SESSION_COOKIE_NAME=msap_sessionid
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
MSAP_PASSWORD_MIN_LENGTH=12
AXES_ENABLED=true
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Keep false unless a trusted proxy replaces client-supplied forwarding headers.
MSAP_TRUST_PROXY_HEADERS=false
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_PROXY_TRUSTED_IPS=
MSAP_STATUS_CACHE_SECONDS=5
MSAP_STATUS_TIMEOUT_SECONDS=1.5
MSAP_APPLICATION_VERSION=0.2.0

# Use DATABASE_URL or the POSTGRES_* variables below.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=msap
POSTGRES_USER=msap_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

MINIO_ENDPOINT=http://localhost:9000
# Browser-visible endpoint used only when generating presigned URLs.
# Falls back to MINIO_ENDPOINT when omitted.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=msap-access
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_APK_UPLOADS=msap-apk-uploads
MINIO_BUCKET_ARTIFACTS=msap-artifacts
MINIO_BUCKET_EVIDENCE=msap-evidence
MINIO_BUCKET_REPORTS=msap-reports
MINIO_BUCKET_EXPORTS=msap-exports

MSAP_MAX_APK_SIZE_BYTES=524288000
MSAP_MAX_MANIFEST_SIZE_BYTES=4194304
MSAP_MAX_APK_ZIP_ENTRIES=10000
MSAP_MAX_APK_UNCOMPRESSED_BYTES=1073741824
MSAP_MAX_APK_ENTRY_BYTES=268435456
MSAP_MAX_APK_COMPRESSION_RATIO=200
MSAP_MAX_DEX_BYTES=268435456
MSAP_MAX_NORMALIZED_MATCHES=500
# Optional development/test mirror root: <root>/<bucket>/<object_key>.
MSAP_LOCAL_APK_ROOT=
# Empty uses the operating system's secure temporary directory.
MSAP_TEMP_DIR=
MSAP_VERIFY_DOWNLOADED_APK_SHA256=true
MSAP_UPLOAD_REQUIRE_SHA256=true
MSAP_PRESIGNED_URL_EXPIRES_SECONDS=900
MSAP_VERIFY_UPLOAD_WITH_HEAD=false
MSAP_DEFAULT_RETENTION_POLICY=active_audit
MSAP_LOG_LEVEL=INFO
MSAP_REDACTION_ENABLED=true

ANALYZER_RULES_PATH=../rules
ANALYZER_WORKDIR=/tmp/msap-analysis
ANALYZER_TIMEOUT_SECONDS=600

REPORT_DEFAULT_FORMAT=json
REPORT_BUCKET=msap-reports
EXPORT_BUCKET=msap-exports
REPORT_INCLUDE_EVIDENCE=true
REPORT_REDACTION_REQUIRED=true
MSAP_REPORT_AUTHOR=MSAP Analyst
MSAP_REPORT_ORGANIZATION=MSAP
MSAP_REPORT_CLASSIFICATION=Security Assessment Report
MSAP_REPORT_VERSION=1.0

AI_ASSISTANT_ENABLED=false
