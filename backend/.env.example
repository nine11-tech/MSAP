DJANGO_SETTINGS_MODULE=msap.settings.development
SECRET_KEY=change-me
DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MSAP_ENVIRONMENT=development
SESSION_COOKIE_NAME=msap_sessionid
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
MSAP_PASSWORD_MIN_LENGTH=12
AXES_ENABLED=true
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Keep false unless a trusted proxy replaces client-supplied forwarding headers.
MSAP_TRUST_PROXY_HEADERS=false
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_PROXY_TRUSTED_IPS=
MSAP_STATUS_CACHE_SECONDS=5
MSAP_STATUS_TIMEOUT_SECONDS=1.5
MSAP_APPLICATION_VERSION=0.2.0

# Local dynamic host agent. Keep disabled unless the agent is running and use a
# fresh local-only token outside source control. For a WSL-hosted backend, use
# http://127.0.0.1:8765; Compose commonly uses host.docker.internal instead.
MSAP_DYNAMIC_HOST_AGENT_ENABLED=false
MSAP_DYNAMIC_HOST_AGENT_URL=http://host.docker.internal:8765
MSAP_DYNAMIC_HOST_AGENT_TOKEN=change-me-local-only
MSAP_DYNAMIC_HOST_AGENT_TIMEOUT_SECONDS=120
MSAP_DYNAMIC_HOST_AGENT_BIND=127.0.0.1
MSAP_DYNAMIC_HOST_AGENT_PORT=8765
MSAP_DYNAMIC_ADB_SERIAL=emulator-5554
MSAP_DYNAMIC_HOST_AGENT_MAX_APK_SIZE_BYTES=314572800
MSAP_DYNAMIC_HOST_AGENT_KEEP_TEMP_APKS=false
MSAP_DYNAMIC_RUNNER_SYNC_DEMO_ENABLED=false
MSAP_DYNAMIC_LAB_PROXY_VALUE=10.0.2.2:18080
MSAP_DYNAMIC_INSTRUMENTED_SNAPSHOT_NAME=msap-instrumented-base

# Ephemeral deterministic agent sandbox. Keep disabled to use the internal
# controller. The gateway URL must be reachable from the selected Docker network.
MSAP_AGENT_CONTAINER_ENABLED=false
MSAP_AGENT_CONTAINER_IMAGE=msap-agent-runtime:local
MSAP_AGENT_CONTAINER_NETWORK=
MSAP_AGENT_GATEWAY_URL=http://host.docker.internal:8000
MSAP_AGENT_RUN_TOKEN_TTL_SECONDS=300
MSAP_AGENT_CONTAINER_TIMEOUT_SECONDS=120

# Plan-only AI assessment planner. Keep DETERMINISTIC for local/offline use.
# The OpenAI credential is backend-only and must never use a VITE_ prefix.
MSAP_ASSESSMENT_PLANNER_PROVIDER=DETERMINISTIC
MSAP_ASSESSMENT_PLANNER_MODEL=gpt-5.5
MSAP_OPENAI_API_KEY=
MSAP_ASSESSMENT_PLANNER_TIMEOUT_SECONDS=60
MSAP_ASSESSMENT_PLANNER_MAX_RETRIES=1
MSAP_ASSESSMENT_PLANNER_RETRY_BASE_MILLISECONDS=250
MSAP_ASSESSMENT_PLANNER_MAX_OUTPUT_TOKENS=8000
MSAP_ASSESSMENT_PLANNER_REASONING_EFFORT=medium
MSAP_ASSESSMENT_MAX_ADAPTIVE_CYCLES=2
MSAP_ASSESSMENT_EXECUTION_TOTAL_TIMEOUT_SECONDS=600
MSAP_ASSESSMENT_EXECUTION_MAX_RETRIES=1
MSAP_ASSESSMENT_EXECUTION_MAX_TOOL_CALLS=96
MSAP_ASSESSMENT_EXECUTION_MAX_OBSERVATION_BYTES=65536
MSAP_ASSESSMENT_EXECUTION_MAX_ARTIFACTS=100
MSAP_ASSESSMENT_EXECUTION_MAX_ARTIFACT_BYTES=25165824
MSAP_AGENT_DECISION_PROVIDER=DETERMINISTIC
MSAP_AGENT_MAX_DECISIONS=24
MSAP_AGENT_MAX_TOOL_CALLS=24
MSAP_AGENT_MAX_PROVIDER_CALLS=24
MSAP_AGENT_MAX_CONSECUTIVE_FAILURES=3
MSAP_AGENT_MAX_DURATION_SECONDS=480
MSAP_AGENT_MAX_ARTIFACTS=50
MSAP_AGENT_MAX_EVIDENCE_RECORDS=50
MSAP_AGENT_MAX_STATE_CONTEXT_BYTES=65536

# Use DATABASE_URL or the POSTGRES_* variables below.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=msap
POSTGRES_USER=msap_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

MINIO_ENDPOINT=http://127.0.0.1:9000
# Browser-visible endpoint used only when generating presigned URLs.
# Falls back to MINIO_ENDPOINT when omitted.
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=msap-access
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_APK_UPLOADS=msap-apk-uploads
MINIO_BUCKET_ARTIFACTS=msap-artifacts
MINIO_BUCKET_EVIDENCE=msap-evidence
MINIO_BUCKET_REPORTS=msap-reports
MINIO_BUCKET_EXPORTS=msap-exports

MSAP_MAX_APK_SIZE_BYTES=524288000
MSAP_MAX_MANIFEST_SIZE_BYTES=4194304
MSAP_MAX_APK_ZIP_ENTRIES=10000
MSAP_MAX_APK_UNCOMPRESSED_BYTES=1073741824
MSAP_MAX_APK_ENTRY_BYTES=268435456
MSAP_MAX_APK_COMPRESSION_RATIO=200
MSAP_MAX_DEX_BYTES=268435456
MSAP_MAX_NORMALIZED_MATCHES=500
MSAP_SOURCE_INDEX_ENABLED=true
# JADX is optional and is never downloaded by MSAP. Enable only when installed.
MSAP_JADX_ENABLED=false
MSAP_SOURCE_INDEX_TIMEOUT_SECONDS=300
MSAP_SOURCE_INDEX_MAX_DOCUMENTS=5000
MSAP_SOURCE_INDEX_MAX_DOCUMENT_BYTES=2097152
MSAP_SOURCE_INDEX_MAX_TOTAL_BYTES=104857600
MSAP_SOURCE_LINE_RANGE_LIMIT=200
# Optional development/test mirror root: <root>/<bucket>/<object_key>.
MSAP_LOCAL_APK_ROOT=
# Empty uses the operating system's secure temporary directory.
MSAP_TEMP_DIR=
MSAP_VERIFY_DOWNLOADED_APK_SHA256=true
MSAP_UPLOAD_REQUIRE_SHA256=true
MSAP_PRESIGNED_URL_EXPIRES_SECONDS=900
MSAP_VERIFY_UPLOAD_WITH_HEAD=true
MSAP_DEFAULT_RETENTION_POLICY=active_audit
MSAP_LOG_LEVEL=INFO
MSAP_REDACTION_ENABLED=true

ANALYZER_RULES_PATH=../rules
ANALYZER_WORKDIR=/tmp/msap-analysis
ANALYZER_TIMEOUT_SECONDS=600

REPORT_DEFAULT_FORMAT=json
REPORT_BUCKET=msap-reports
EXPORT_BUCKET=msap-exports
REPORT_INCLUDE_EVIDENCE=true
REPORT_REDACTION_REQUIRED=true
MSAP_REPORT_AUTHOR=MSAP Analyst
MSAP_REPORT_ORGANIZATION=MSAP
MSAP_REPORT_CLASSIFICATION=Security Assessment Report
MSAP_REPORT_VERSION=1.0

AI_ASSISTANT_ENABLED=false
